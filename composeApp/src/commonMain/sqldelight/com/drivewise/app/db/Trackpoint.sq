CREATE TABLE TrackPoint (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  lesson_id TEXT NOT NULL,

  lon REAL NOT NULL,
  lat REAL NOT NULL,

  speed_kmh REAL NOT NULL,
  bearing_deg REAL,         -- nullable

  timestamp_ms INTEGER NOT NULL
);

createPoint:
INSERT INTO TrackPoint(
  lesson_id, lon, lat, speed_kmh, bearing_deg, timestamp_ms
) VALUES (?, ?, ?, ?, ?, ?);

pointsByLesson:
SELECT * FROM TrackPoint
WHERE lesson_id = ?
ORDER BY timestamp_ms ASC;

lastPointByLesson:
SELECT * FROM TrackPoint
WHERE lesson_id = ?
ORDER BY timestamp_ms DESC
LIMIT 1;

deleteLessonPoints:
DELETE FROM TrackPoint
WHERE lesson_id = ?;

countByLesson:
SELECT COUNT(*) FROM TrackPoint
WHERE lesson_id = ?;

-- Tek ders için aggregate (Report ekranı için)
lessonAgg:
SELECT
  lesson_id            AS lessonId,
  COUNT(*)             AS pointsSaved,
  MIN(timestamp_ms)    AS startedAtMs,
  MAX(timestamp_ms)    AS endedAtMs,
  AVG(speed_kmh)       AS avgSpeedKmh,
  MAX(speed_kmh)       AS maxSpeedKmh
FROM TrackPoint
WHERE lesson_id = ?
GROUP BY lesson_id;

-- Lesson history list (tüm dersler)
lessonSummaries:
SELECT
  lesson_id            AS lessonId,
  COUNT(*)             AS pointsSaved,
  MIN(timestamp_ms)    AS startedAtMs,
  MAX(timestamp_ms)    AS endedAtMs,
  AVG(speed_kmh)       AS avgSpeedKmh,
  MAX(speed_kmh)       AS maxSpeedKmh
FROM TrackPoint
GROUP BY lesson_id
ORDER BY startedAtMs DESC;

lessonSummaryById:
SELECT
  lesson_id            AS lessonId,
  COUNT(*)             AS pointsSaved,
  MIN(timestamp_ms)    AS startedAtMs,
  MAX(timestamp_ms)    AS endedAtMs,
  AVG(speed_kmh)       AS avgSpeedKmh,
  MAX(speed_kmh)       AS maxSpeedKmh
FROM TrackPoint
WHERE lesson_id = ?
GROUP BY lesson_id;
