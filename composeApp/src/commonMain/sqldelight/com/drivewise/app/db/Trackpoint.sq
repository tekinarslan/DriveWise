CREATE TABLE TrackPoint (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  lesson_id TEXT NOT NULL,

  lat REAL NOT NULL,
  lon REAL NOT NULL,

  speed_kmh REAL NOT NULL,
  bearing_deg REAL,         -- nullable

  timestamp_ms INTEGER NOT NULL
);

createPoint:
INSERT INTO TrackPoint(
  lesson_id, lat, lon, speed_kmh, bearing_deg, timestamp_ms
) VALUES (?, ?, ?, ?, ?, ?);

pointsByLesson:
SELECT * FROM TrackPoint
WHERE lesson_id = ?
ORDER BY timestamp_ms ASC;

deleteLessonPoints:
DELETE FROM TrackPoint WHERE lesson_id = ?;

countByLesson:
SELECT COUNT(*) FROM TrackPoint WHERE lesson_id = ?;

lastPointByLesson:
SELECT * FROM TrackPoint
WHERE lesson_id = ?
ORDER BY timestamp_ms DESC
LIMIT 1;
